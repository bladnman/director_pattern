# Director Pattern: only machine-local files stay out of Git.
# Everything else in .director/ is committed with the project.

# Request helper lock and in-progress write scratch
/.requests.lock
/.request-txn
/.request-stage-*
/.request-complete-*

# Pre-update safety copies; committed history already keeps prior versions
/backups/

# Daily update discovery is machine-local; project policy remains committed
/.update-check.json
/.update-check.lock
/.update-check-*.tmp
