{
  "name": "director-pattern-site",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-05-03",
  "workers_dev": true,
  "preview_urls": true,
  "build": { "command": "node scripts/build.mjs" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
